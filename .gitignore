# Dependencies — each package installs its own.
node_modules/

# Build output / caches
.next/
dist/
*.tsbuildinfo

# Secrets. Real keys live in ~/.devdigest/secrets.json (mode 0600), never here.
.env
.env.*
!.env.example

# Cloned user repos — see AGENTS.md "Do not touch".
server/clones/

# The design bundle and everything unpacked from it. The .html is 1.7 MB of
# base64+gzip assets behind a JSON manifest (INSIGHTS.md, "Tool & Library
# Notes") — it does not diff, and committing it would weigh the history down
# forever. Keep it locally; regenerate design-mocks/ from it rather than commit.
DevDigest Design (standalone).html
design-mocks/

# Local agent/session state. `.claude/skills/` and `.claude/agents/` are shared:
# AGENTS.md tells every agent to run `engineering-insights`, so the skill has to
# travel with the repo, and the agent set encodes this repo's own gates, layering
# rules and doc surfaces — it is worth no more than the repo it was written for.
.claude/*
!.claude/skills/
!.claude/agents/
.claude/settings.local.json
