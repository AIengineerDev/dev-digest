# Dependencies — each package installs its own.
node_modules/

# Build output / caches
.next/
dist/
*.tsbuildinfo

# Secrets. Real keys live in ~/.devdigest/secrets.json (mode 0600), never here.
.env
.env.*
!.env.example

# Cloned user repos — see AGENTS.md "Do not touch".
server/clones/

# Unpacked from "DevDigest Design (standalone).html" — regenerate rather than commit.
design-mocks/

# Local agent/session state. `.claude/skills/` is shared — AGENTS.md tells every
# agent to run `engineering-insights`, so the skill has to travel with the repo.
.claude/*
!.claude/skills/
.claude/settings.local.json
