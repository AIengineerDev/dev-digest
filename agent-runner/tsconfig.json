{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": true,
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    // `@devdigest/shared` and `@devdigest/reviewer-core` are reached through
    // path aliases and consumed as TypeScript SOURCE — same arrangement as
    // `mcp` (mcp/tsconfig.json:22-30) and `reviewer-core` itself. This package
    // never emits with tsc: an `outDir` would pull those aliased sources into
    // the program and write them under dist/ too, alongside our own — that is
    // why the bundle step is `ncc`, not `tsc`, and `build` here is only a
    // type-check. The `zod` alias pins both this package's own `z.object()`
    // calls and the schemas re-exported from `@devdigest/shared` to the SAME
    // installed copy, matching `reviewer-core/tsconfig.json`.
    "paths": {
      "@devdigest/shared": ["../server/src/vendor/shared/index.ts"],
      "@devdigest/shared/*": ["../server/src/vendor/shared/*"],
      "@devdigest/reviewer-core": ["../reviewer-core/src/index.ts"],
      "@devdigest/reviewer-core/*": ["../reviewer-core/src/*"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
