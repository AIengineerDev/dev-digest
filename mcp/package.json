{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "devdigest-mcp — MCP server exposing DevDigest's reviewers over stdio. A thin HTTP client of the API on :3001; holds no state and no business logic of its own.",
  "bin": {
    "devdigest-mcp": "./bin/devdigest-mcp.mjs"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "tsx": "^4.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
